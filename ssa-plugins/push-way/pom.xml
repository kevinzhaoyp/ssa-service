<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.ssa</groupId>
        <artifactId>ssa-plugins</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>push-way</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ssa</groupId>
            <artifactId>ssa-core-starter</artifactId>
            <version>2.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>

        <!-- JavaMail -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <!-- 阿里云短信 SDK -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>dysmsapi20170525</artifactId>
            <version>3.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 将第三方依赖拷贝到共享的 plugins/lib/ 目录，启动时由 ssa-ser 统一加载 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${plugins.output.dir}/lib</outputDirectory>
                            <!-- 只拷贝指定的依赖，不拷贝传递依赖。
                                 ⚠️ 必须列出 angus-mail / dysmsapi 的完整传递闭包，
                                 漏一个就是运行时 NoClassDefFoundError（如 jakarta/mail/Authenticator）。
                                 闭包清单用 mvn dependency:tree 提取，改依赖版本后要重新核对。 -->
                            <includeArtifactIds>angus-mail,jakarta.mail-api,jakarta.activation-api,angus-activation,
                                dysmsapi20170525,tea,tea-util,tea-openapi,tea-xml,endpoint-util,openapiutil,
                                credentials-java,alibabacloud-gateway-spi,
                                okhttp,okio,okio-jvm,kotlin-stdlib,kotlin-stdlib-jdk7,kotlin-stdlib-jdk8,kotlin-stdlib-common,
                                gson,error_prone_annotations,commons-codec,annotations,
                                jakarta.xml.bind-api,jaxb-api,jaxb-core,jaxb-impl,dom4j,ini4j,
                                bcpkix-jdk15on,bcprov-jdk15on,bcutil-jdk15on</includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>