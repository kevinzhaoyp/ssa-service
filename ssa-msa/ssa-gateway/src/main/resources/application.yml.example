server:
  port: 8080
  servlet:
    context-path: /
spring:
  application:
    name: gateway
  config:
    import: "optional:nacos:${spring.application.name}.yaml"
  cloud:
    nacos:
      username: ${NACOS_USERNAME:nacos}
      password: ${NACOS_PASSWORD:}              # 不要写明文，部署时由环境变量注入
      discovery:
        server-addr: ${NACOS_HOST:127.0.0.1}:8800
        namespace: gateway2
      config:
        server-addr: ${NACOS_HOST:127.0.0.1}:8800
        namespace: gateway2
        extension-configs:
          - data-id: discovery.yaml
            group: PUBLIC
            refresh: true
          - data-id: redis-auth.yaml
            group: PUBLIC
            refresh: true

    gateway:
      discovery:
        locator:
          enabled: true
          lower-case-service-id: true
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: 9900
      password: ${REDIS_PASSWORD:}             # 不要写明文
      timeout: 2000
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0

# 网关配置
ssa:
  gateway:
    rate-limit:
      max-requests-per-minute: 100
      key-prefix: "rate_limit:"
      enabled: true

# JWT配置
jwt:
  secret: ${JWT_SECRET:}                       # 必须替换为强随机串，不要写明文
  expiration: ${JWT_EXPIRATION:86400}

# Actuator配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    export:
      simple:
        enabled: true
