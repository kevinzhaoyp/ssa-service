server:
  port: 8081
  servlet:
    context-path: /
spring:
  application:
    name: oauth
  config:
    import: "optional:nacos:${spring.application.name}.yaml"
  cloud:
    nacos:
      server-addr: ${NACOS_HOST:127.0.0.1}:8800  # Nacos 服务器地址（替换为你的）
      username: ${NACOS_USERNAME:nacos}
      password: ${NACOS_PASSWORD:}              # 不要写明文，部署时由环境变量注入
      discovery:
        namespace: gateway2
        group: DEFAULT_GROUP
      config:
        file-extension: yaml
        namespace: gateway2
        group: DEFAULT_GROUP
        extension-configs:
          - data-id: common.yaml
            group: PUBLIC
            refresh: true
          - data-id: redis-auth.yaml
            group: PUBLIC
            refresh: true
# JWT配置
jwt:
  secret: ${JWT_SECRET:}                        # 必须替换为强随机串，不要写明文
  access-token-expiration: 7200
  refresh-token-expiration: 604800

# 自定义配置
oauth:
  jwt:
    issuer: https://ssa-oauth.example.com
    audience: ssa-app-users

# Actuator配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,jwt,jwks
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    export:
      simple:
        enabled: true

logging:
  level:
    com.ssa.oauth: DEBUG
    org.springframework.security: DEBUG
    com.alibaba.nacos: INFO

# ssa 插件配置（加载 sql-api 插件）
ssa:
  plugin:
    pluginPath: ${SSA_PLUGIN_PATH:./plugins/}
    plugins:
      - key: sql-api
        fileName: sql-api-2.0.0.jar
        state: enable
        type: jar
  oauth:
    sqlapi:
      user-by-identifier: user.login
      user-by-id: user.getUserInfo
      user-permissions: user.permissions
      user-roles: user.roles
    client-cache-ttl-seconds: 300


sqlapi:
  datasource:
    main:
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: jdbc:mysql://${DB_HOST:127.0.0.1}:3306/ssa
      username: ${DB_USERNAME:root}
      password: ${DB_PASSWORD:}                 # 不要写明文
      max-active: 200
  template:
    cache: 0
    path:
      - ${SSA_SQL_YMLAPI_PATH:./sql/mysql/ymlapi}
